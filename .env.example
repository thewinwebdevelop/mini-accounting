# Public deployment origin, including scheme and port when applicable.
APP_PUBLIC_ORIGIN=https://accounting.example.com

# LINE MINI App / LIFF public and server-side configuration.
LINE_LIFF_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# disabled keeps the current local compatibility behavior; production must use line.
SWEET_HOUSE_AUTH_MODE=disabled
SWEET_HOUSE_SESSION_SECRET=replace-with-at-least-32-random-bytes
SWEET_HOUSE_SESSION_TTL_SECONDS=43200
SWEET_HOUSE_COOKIE_SECURE=0

# Supabase server-only configuration. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sweet-house-files

# Data persistence cutover. Keep local for compatibility until migration checks pass.
DATA_BACKEND=local
DATA_BACKEND_INVENTORY=
DATA_BACKEND_DOCUMENTS=
DATA_BACKEND_FILES=
DATA_BACKEND_FALLBACK=

# Existing integrations.
GOOGLE_OAUTH_REDIRECT_URI=https://accounting.example.com/api/google-drive/oauth2callback
