# Public deployment origin, including scheme and port when applicable.
APP_PUBLIC_ORIGIN=https://accounting.example.com

# LINE MINI App / LIFF public and server-side configuration.
LINE_LIFF_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_INTAKE_MAX_BYTES=20971520
LINE_INTAKE_MINI_APP_URL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_INTAKE_MINI_APP_URL=https://accounting.example.com/line-intake
LINE_INTAKE_MAX_BYTES=20971520
# local keeps development self-contained; production should use supabase after migration 005.
LINE_INTAKE_BACKEND=local
LINE_OCR_PROVIDER=manual
LINE_OCR_API_URL=
LINE_OCR_API_KEY=

# disabled keeps the current local compatibility behavior; production must use line.
SWEET_HOUSE_AUTH_MODE=disabled
SWEET_HOUSE_SESSION_SECRET=replace-with-at-least-32-random-bytes
SWEET_HOUSE_SESSION_TTL_SECONDS=43200
SWEET_HOUSE_COOKIE_SECURE=0

# Local-only auth bypass for testing. Never use mock with NODE_ENV=production or network binding.
# SWEET_HOUSE_AUTH_MODE=mock
# SWEET_HOUSE_MOCK_USER_ID=local-fixture-user-id
# SWEET_HOUSE_MOCK_ROLE=employee
# SWEET_HOUSE_MOCK_DISPLAY_NAME=Local Mock User
# SWEET_HOUSE_MOCK_LINE_USER_ID=U_LOCAL_MOCK_USER
# SWEET_HOUSE_MOCK_FIRST_NAME=Local
# SWEET_HOUSE_MOCK_LAST_NAME=Mock User
# SWEET_HOUSE_MOCK_POSITION_ID=mock-owner

# Supabase server-only configuration. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sweet-house-files

# Data persistence cutover. Keep local for compatibility until migration checks pass.
DATA_BACKEND=local
DATA_BACKEND_INVENTORY=
DATA_BACKEND_DOCUMENTS=
DATA_BACKEND_FILES=
DATA_BACKEND_FALLBACK=

# Existing integrations.
GOOGLE_OAUTH_REDIRECT_URI=https://accounting.example.com/api/google-drive/oauth2callback
